# Dockerfile-specific allowlist: private/runtime trees never enter the build context.
*
!pyproject.toml
!src/
!src/**
!packaging/
!packaging/core/
!packaging/core/requirements.txt
!packaging/core/prepare_source.py
!packaging/core/healthcheck.py
!docs/
!docs/thesis/
!docs/thesis/tcc_claim_registry.json
!configs/
!configs/qkd_assurance/
!configs/qkd_assurance/irelandqci_example_operating_point.json
!evidence/
!evidence/tcc/
!evidence/tcc/v1.0.0/
!evidence/tcc/v1.0.0/tables/
!evidence/tcc/v1.0.0/tables/*.csv
!outputs/
!outputs/qkd_coexistence_measured/
!outputs/qkd_coexistence_measured/experimental_cells.csv
src/quantum_autopilot/console/
src/quantum_autopilot/desktop.py
**/__pycache__/
**/*.pyc
**/*.pem
**/*.key
**/*.pfx
**/*.p12
**/*.sqlite
**/*.sqlite3
**/*.db
**/.security/
**/.git/
