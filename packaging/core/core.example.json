{
  "schema": "orion.core-service.v1",
  "repository_root": "/opt/orionq",
  "state_root": "/var/lib/orionq",
  "identity": {
    "subject": "orion-core",
    "credential_file": "/run/secrets/orion-service"
  },
  "provisioning_identity": {
    "subject": "orion-admin",
    "credential_file": "/run/secrets/orion-admin"
  },
  "vault": {
    "key_id": "master-v1",
    "key_file": "/run/secrets/orion-vault",
    "previous_keys": {}
  },
  "http": {
    "host": "0.0.0.0",
    "port": 8765,
    "allowed_hosts": ["0.0.0.0", "orion-core", "localhost", "127.0.0.1"],
    "allowed_origins": [],
    "requests_per_minute": 120,
    "max_concurrency": 8,
    "body_timeout_seconds": 5,
    "operation_timeout_seconds": 30
  },
  "tls": {
    "root": "/var/lib/orionq/certificates",
    "server_leaf": "/etc/orionq/server-leaf.json"
  },
  "clock": {
    "enabled": true,
    "period_s": 1.0,
    "stop_timeout_s": 10.0
  }
}
