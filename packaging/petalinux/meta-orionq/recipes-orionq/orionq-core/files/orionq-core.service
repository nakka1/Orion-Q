[Unit]
Description=OrionQ authenticated embedded headless core
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
User=orionq
Group=orionq
WorkingDirectory=/usr/share/orionq/resources
ExecStartPre=/usr/bin/python3 -I /usr/libexec/orionq/platform-preflight.py --config /etc/orionq/platform.json --artifact /usr/share/orionq/core-artifact.json
ExecStartPre=/usr/bin/python3 -I -m quantum_autopilot.service.cli --config /etc/orionq/core.json check
ExecStart=/usr/bin/python3 -I -m quantum_autopilot.service.cli --config /etc/orionq/core.json serve
LoadCredential=orion-service:/etc/orionq/secrets/orion-service
LoadCredential=orion-vault:/etc/orionq/secrets/orion-vault
StateDirectory=orionq
StateDirectoryMode=0700
UMask=0077
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=2
TimeoutStartSec=90s
TimeoutStopSec=90s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
