[Unit]
Description=OrionQ external PS/PL correlation gateway
After=local-fs.target
StartLimitIntervalSec=300
StartLimitBurst=3

[Service]
Type=exec
# The implemented socket transport authorizes one UID, not a shared group.
User=orionq
Group=orionq
RuntimeDirectory=orionq-pl
RuntimeDirectoryMode=0700
# Replay tombstones must survive RuntimeDirectory cleanup and reboot.
StateDirectory=orionq-pl
StateDirectoryMode=0700
UMask=0077
ExecStartPre=/usr/bin/python3 -I -m quantum_autopilot.service.pl_gateway_cli --config /etc/orionq/pl-gateway.json check
ExecStart=/usr/bin/python3 -I -m quantum_autopilot.service.pl_gateway_cli --config /etc/orionq/pl-gateway.json serve
Restart=on-failure
RestartSec=10s
RestartPreventExitStatus=2
TimeoutStartSec=30s
TimeoutStopSec=90s
KillSignal=SIGTERM
KillMode=control-group
SendSIGKILL=yes
LimitCORE=0
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictAddressFamilies=AF_UNIX
StandardInput=null
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
