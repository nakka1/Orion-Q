  "status": "exploratory hybrid replay",
  "target": "Bell-state fidelity simulated by QuantumChannel.simulate_fidelity",
  "horizons": [1, 4],
  "models": ["ridge", "edge_lstm", "edge_gru", "edge_tcn"],
