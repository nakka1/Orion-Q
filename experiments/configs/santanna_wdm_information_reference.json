  "familywise_alpha": 0.05,
  "multiple_comparison_correction": "Bonferroni over every target-horizon-model-contrast",
  "hidden_size": 8,
  "max_epochs": 6,
  "batch_size": 512,
  "early_stopping_patience": 3,
  "learning_rate": 0.001,
  "confirmation_rule": [
    "corrected CI lower bound > 0 for combined versus autoregressive",
    "corrected CI lower bound > 0 for combined versus within-device permuted-WDM control"
  ],
  "claim_limit": "Tests predictive information for recorded optical targets, not measured quantum fidelity. A new untouched campaign is required for confirmatory inference."
