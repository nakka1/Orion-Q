{
  "status": "exploratory_reference_after_prior_use_of_hard_and_soft_labels",
  "dataset": "HardFailure_dataset.csv",
  "targets": ["osnr_db", "pre_fec_ber"],
  "horizons": [3, 10],
  "models": ["ridge", "edge_lstm", "edge_gru", "edge_tcn"],
